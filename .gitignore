__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv313/
venv/
# Build and release output
/dist/
/build/
/releases/

# Local runtime state and market data.  These are root-anchored on purpose:
# an unanchored ``runtime/`` also matched ``src/us_quant/trading/runtime/``
# and silently excluded a real source package from the repository.
/data/
/runtime/
*.sqlite
*.sqlite3
*.db
*.spec

# Local visual-acceptance screenshots: the desktop runtime page prints this
# machine's absolute state root, so rendered PNGs carry local paths.
research/artifacts/*.png

# Secrets and local overrides
.env
.env.*
!.env.example
configs/*.local.toml
secrets/

# Local agent/session state.  Root-anchored on purpose, the same way /runtime/
# is: these notes carry machine-specific provenance (session paths, local
# branches) that must not reach a published tree, and the publish-safety gate
# scans untracked files, so leaving them publishable would make the gate fail
# on scratch rather than on real leaks.
/.workbuddy/

# Local OpenCodeReview output.  A review run writes a timestamped directory of
# machine-specific artifacts -- absolute repository paths, the resolved rule
# text, and the findings themselves.  None of it is a source artifact: the
# review is advisory, it is reproducible from its command, and committing it
# would make the *next* review's diff contain the previous review's findings.
# Root-anchored for the same reason /runtime/ is: ``.ocr-output`` is a local
# directory name and must never be able to shadow a real source path.
/.ocr-output/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
